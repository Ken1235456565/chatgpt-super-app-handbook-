SITE_URL=https://your-project.vercel.app

# Guestbook (see docs/COMMENT_FEATURE_DESIGN.md). All optional in `pnpm dev`:
# without Supabase comments are kept in memory, without OpenAI translation is a placeholder,
# and without Turnstile keys Cloudflare's always-pass test keys are used.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Required, also locally. Generate with `pnpm guestbook:hash-password`.
# In .env files, escape each $ in the hash as \$ ; in the Vercel dashboard paste it unchanged.
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
